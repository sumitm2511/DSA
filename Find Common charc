class Solution {
public:
    vector<string> commonChars(vector<string>& words) {

        unordered_map<char,int> minfreq;
        for(char curr='a';curr<='z';curr++){
            minfreq[curr]=INT_MAX;
        }

        for(auto word:words){
            unordered_map<char,int> freq;
            for(auto ch:word){
                freq[ch]++;

            }
            for(char temp='a';temp<='z';temp++){
                minfreq[temp]=min(minfreq[temp],freq[temp]);
            }
        }


        vector<string> ans;

      for(char dummy='a';dummy<='z';dummy++){
        while(minfreq[dummy]>0){
            ans.push_back(string(1,dummy));
            minfreq[dummy]--;

        }
      }

        return ans;
       
        
    }
};
