vector<int> minMaxCandy(vector<int>& prices, int k) {
        // Code here
        sort(prices.begin(),prices.end());
        int n=prices.size();
        
        int min_price=0;
        int i=0,j=n-1;
        while(i<=j){
            min_price+=prices[i];
            i++;
            j-=k;
        }
        
        int m=0,l=n-1;
        int max_price=0;
        while(l>=m){
            max_price+=prices[l];
            l--;
            m+=k;
        }
        return {min_price,max_price};
    }
